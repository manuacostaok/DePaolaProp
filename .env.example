# Base de datos (PostgreSQL vía Prisma — Fase 17, decisión ya tomada, no reabrir)
DATABASE_URL="postgresql://usuario:password@host:5432/depaolaprop"

# Firma de sesión del panel /admin (Fase 19). Generar uno propio por entorno:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Contraseña para el alta inicial del admin en `npx prisma db seed` (solo se
# usa si la cuenta todavía no existe — el seed nunca pisa una contraseña ya
# creada). Sin esta variable, se genera una al azar y se imprime una vez en
# consola. Nunca commitear un valor real acá.
SEED_ADMIN_PASSWORD=""

# Mapas — TODO: confirmar proveedor definitivo (Fase 17 lo deja abierto).
# Default razonable para arrancar: Google Maps (gratis para volumen bajo).
GOOGLE_MAPS_API_KEY=""

# IA para el buscador conversacional "De Paola AI" (Fase 10 / Fase 14 del master plan).
# TODO: confirmar proveedor definitivo antes de construir esa fase — no bloquea el resto del sitio.
AI_PROVIDER_API_KEY=""

# Analytics (Fase 20/22 del plan) — ID de medición de GA4 (formato G-XXXXXXX).
# Sin esta variable, GoogleAnalytics no se renderiza (ver app/layout.tsx) —
# no rompe nada, simplemente no manda datos hasta que se cargue el ID real.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
